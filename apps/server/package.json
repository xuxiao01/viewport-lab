{
  "name": "@viewport-lab/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/agent/prompts.md dist/agent/prompts.md",
    "test": "node --import tsx --test src/*.test.ts src/agent/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@playwright/cli": "0.1.17",
    "@viewport-lab/shared": "workspace:*",
    "fastify": "^5.4.0",
    "openai": "^6.48.0",
    "playwright": "^1.53.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
